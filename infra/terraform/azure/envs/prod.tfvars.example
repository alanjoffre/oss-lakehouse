# Produção: outra subscription (ou ao menos outro RG/estado), réplica zonal, sem acesso público.
subscription_id        = "11111111-1111-1111-1111-111111111111"
env                    = "prod"
location               = "brazilsouth"
storage_replication    = "ZRS"
public_network_access  = "Disabled" # só por private endpoint
allowed_ip_ranges      = []
cluster_max_workers    = 8
create_kv_secret_scope = true

groups = {
  engineers = "data-engineers"
  analysts  = "data-analysts"
}

# az ad sp show --id 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d --query id -o tsv
azure_databricks_sp_object_id = "22222222-2222-2222-2222-222222222222"
